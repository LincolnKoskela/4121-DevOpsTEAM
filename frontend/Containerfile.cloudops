FROM docker.io/nginx/nginx-unprivileged@sha256:016193c18ef1ce19dc2229d3305f69af1b05e0bc0e8fe6ee724a58bd305f3855

USER root

RUN apk upgrade --no-cache

COPY nginx.cloudops.conf /etc/nginx/conf.d/default.conf
COPY build/ /usr/share/nginx/html/

RUN chmod 644 /etc/nginx/conf.d/default.conf \
    && chmod -R a+rX /usr/share/nginx/html

USER nginx

EXPOSE 8082
