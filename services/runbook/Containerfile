FROM docker.io/library/python@sha256:69ebe56e2a764c399514a0a6117131cb730cc4d0e71e85c08deb9af74cbb9f41

RUN apk upgrade --no-cache

WORKDIR /app

RUN addgroup -S runbook && adduser -S -G runbook runbook

COPY requirements.txt .
RUN python -m pip install --no-cache-dir --only-binary=:all: -r requirements.txt \
    && python -m pip check

COPY --chown=runbook:runbook app/ ./app/

USER runbook

EXPOSE 5000
CMD ["uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "5000"]
