FROM docker.io/library/node@sha256:4eefa1bfce4197942661ef9148247d779ddf1bb0ee006d3294a467609de60724 AS dependencies

RUN apk upgrade --no-cache

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM docker.io/library/node@sha256:4eefa1bfce4197942661ef9148247d779ddf1bb0ee006d3294a467609de60724

RUN apk upgrade --no-cache

WORKDIR /app

RUN rm -rf /usr/local/lib/node_modules/npm /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx \
             /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package*.json ./
COPY --chown=node:node src/ ./src/

USER node

EXPOSE 3000
CMD ["node", "src/index.js"]
